@page "/forgot-password"
@using src.Models
@using src.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@layout src.Layout.MainLayout

<PageTitle>Restablecer Contraseña - Sistema Gastronómico</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">Restablecer Contraseña</h4>
                </div>
                <div class="card-body p-4">
                    @if (isSuccess)
                    {
                        <div class="alert alert-success">
                            Tu cuenta está siendo verificada. Intenta iniciar sesión con tu nueva contraseña en 10-15 minutos si el administrador la aprueba.
                        </div>
                        <div class="text-center mt-3">
                            <a href="/login" class="btn btn-outline-primary">Volver al login</a>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />

                            <div class="mb-3">
                                <label for="email" class="form-label">Correo Electrónico</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="forgotPasswordModel.Email" placeholder="ejemplo@uta.edu.ec" />
                                <ValidationMessage For="@(() => forgotPasswordModel.Email)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="telefono" class="form-label">Teléfono Registrado</label>
                                <InputText id="telefono" type="tel" class="form-control" @bind-Value="forgotPasswordModel.Telefono" placeholder="0999999999" />
                                <ValidationMessage For="@(() => forgotPasswordModel.Telefono)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">Nueva Contraseña</label>
                                <InputText id="newPassword" type="password" class="form-control" @bind-Value="forgotPasswordModel.NewPassword" />
                                <ValidationMessage For="@(() => forgotPasswordModel.NewPassword)" class="text-danger" />
                            </div>

                            <div class="mb-4">
                                <label for="confirmPassword" class="form-label">Confirmar Contraseña</label>
                                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="forgotPasswordModel.ConfirmPassword" />
                                <ValidationMessage For="@(() => forgotPasswordModel.ConfirmPassword)" class="text-danger" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <span>Solicitar Restablecimiento</span>
                                    }
                                </button>
                                <a href="/login" class="btn btn-link text-decoration-none">Volver al login</a>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading;
    private string? errorMessage;
    private bool isSuccess;

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthService.ForgotPasswordAsync(forgotPasswordModel);

        if (result.Exito)
        {
            isSuccess = true;
        }
        else
        {
            errorMessage = result.Mensaje;
        }

        isLoading = false;
    }
}
