@page "/forgot-password"
@using src.Models
@using src.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@layout AuthLayout

<PageTitle>Restablecer Contraseña - Sistema Gastronómico</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-uta-blue mb-2">Restablecer Contraseña</h3>
                    <p class="text-muted small">Ingresa tus datos para solicitar una nueva contraseña</p>
                </div>

                @if (isSuccess)
                {
                    <div class="alert alert-success border-success-subtle shadow-sm rounded-3 p-4 text-center">
                        <i class="bi bi-check-circle-fill fs-1 text-success d-block mb-3"></i>
                        <h5 class="fw-bold text-success mb-2">¡Solicitud enviada!</h5>
                        <p class="mb-0 small text-dark">
                            Tu cuenta está siendo verificada. Intenta iniciar sesión con tu nueva contraseña en 10-15 minutos si el administrador la aprueba.
                        </p>
                    </div>
                    <div class="text-center mt-4">
                        <a href="/login" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                            <i class="bi bi-arrow-left me-2"></i>Volver al login
                        </a>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger shadow-sm rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }

                    <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-envelope-fill"></i></span>
                                <InputText type="email" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="forgotPasswordModel.Email" placeholder="usuario@uta.edu.ec" />
                            </div>
                            <ValidationMessage For="@(() => forgotPasswordModel.Email)" class="text-danger small mt-1 fw-semibold" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark">Teléfono Registrado</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-telephone-fill"></i></span>
                                <InputText type="tel" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="forgotPasswordModel.Telefono" placeholder="0999999999" />
                            </div>
                            <ValidationMessage For="@(() => forgotPasswordModel.Telefono)" class="text-danger small mt-1 fw-semibold" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-lock-fill"></i></span>
                                <InputText type="@(showNewPassword ? "text" : "password")" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="forgotPasswordModel.NewPassword" placeholder="********" />
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50" style="cursor: pointer" @onclick="() => showNewPassword = !showNewPassword">
                                    <i class="bi @(showNewPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                </span>
                            </div>
                            <ValidationMessage For="@(() => forgotPasswordModel.NewPassword)" class="text-danger small mt-1 fw-semibold" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-dark">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-lock-fill"></i></span>
                                <InputText type="@(showConfirmPassword ? "text" : "password")" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="forgotPasswordModel.ConfirmPassword" placeholder="********" />
                                <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50" style="cursor: pointer" @onclick="() => showConfirmPassword = !showConfirmPassword">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                </span>
                            </div>
                            <ValidationMessage For="@(() => forgotPasswordModel.ConfirmPassword)" class="text-danger small mt-1 fw-semibold" />
                        </div>

                        <button type="submit" class="btn btn-uta-primary w-100 py-3 fw-bold rounded-3 shadow-sm mb-3" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Procesando...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill me-2 fs-6"></i>
                                <span>Solicitar Restablecimiento</span>
                            }
                        </button>

                        <div class="text-center mt-3">
                            <a href="/login" class="text-decoration-none fw-semibold text-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Volver al login
                            </a>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-uta-blue {
        color: #003865 !important;
    }
    .btn-uta-primary {
        background-color: #004b87 !important;
        border-color: #004b87 !important;
        color: #ffffff !important;
        transition: background-color 0.15s ease;
    }
    .btn-uta-primary, .btn-uta-primary * {
        color: #ffffff !important;
    }
    .btn-uta-primary:hover {
        background-color: #002847 !important;
        border-color: #002847 !important;
        color: #ffffff !important;
    }
    .btn-uta-primary:hover * {
        color: #ffffff !important;
    }
</style>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading;
    private string? errorMessage;
    private bool isSuccess;

    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthService.ForgotPasswordAsync(forgotPasswordModel);

        if (result.Exito)
        {
            isSuccess = true;
        }
        else
        {
            errorMessage = result.Mensaje;
        }

        isLoading = false;
    }
}
