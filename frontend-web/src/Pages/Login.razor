@page "/login"


@layout AuthLayout


@inject AuthService AuthService


@inject NavigationManager Navigation





<PageTitle>Acceso al Panel - Sistema Gastronómico UTA</PageTitle>





<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">


    <div class="col-12 col-md-8 col-lg-6 col-xl-5">


        <!-- Contenedor simple sin anidar multiples cards -->


        <div class="bg-white p-4 p-sm-5 rounded-4 shadow-sm border border-secondary border-opacity-25">


            <div class="text-center mb-4">


                <i class="bi bi-person-workspace text-primary" style="font-size: 3rem;"></i>


                <h4 class="fw-bold text-dark mt-3">Portal de Propietarios</h4>


                <p class="text-muted small">Accede para administrar tu local comercial</p>


            </div>





            @if (!string.IsNullOrEmpty(errorMessage))


            {


                <div class="alert alert-danger d-flex align-items-center py-2 px-3 border-danger bg-danger-subtle mb-4" role="alert">


                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>


                    <div class="small fw-semibold text-danger">@errorMessage</div>


                </div>


            }





            <!-- Selector de Pestéañas con Alto Contraste -->


            <div class="bg-light p-1 rounded-pill d-flex mb-4 border border-secondary border-opacity-25">


                <button class="btn btn-sm flex-fill rounded-pill fw-bold py-2 @(isLogin ? "btn-primary shadow-sm" : "text-dark")"


                        @onclick="() => isLogin = true">


                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión


                </button>


                <button class="btn btn-sm flex-fill rounded-pill fw-bold py-2 @(!isLogin ? "btn-primary shadow-sm" : "text-dark")"


                        @onclick="() => isLogin = false">


                    <i class="bi bi-person-plus-fill me-1"></i> Registrarse


                </button>


            </div>





            @if (isLogin)


            {


                <EditForm EditContext="loginContext" OnValidSubmit="HandleLogin">


                    <DataAnnotationsValidator />





                    <div class="mb-3">


                        <label class="form-label fw-bold small text-dark">Correo Electrónico</label>


                        <div class="input-group">


                            <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-envelope-fill"></i></span>


                            <InputText class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="loginModel.Email" @bind-Value:after="RevalidarLogin" placeholder="ejemplo@uta.edu.ec" />


                        </div>


                        <ValidationMessage For="() => loginModel.Email" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <div class="mb-4">


                        <label class="form-label fw-bold small text-dark d-flex justify-content-between w-100"><span>Contraseña</span><a href="/forgot-password" class="text-decoration-none text-uta-blue">¿Olvidaste tu contraseña?</a></label>


                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-lock-fill"></i></span>
                            <InputText type="@(showPassword ? "text" : "password")" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="loginModel.Password" @bind-Value:after="RevalidarLogin" placeholder="********" />
                            <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50" style="cursor: pointer" @onclick="() => showPassword = !showPassword">
                                <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </span>
                        </div>


                        <ValidationMessage For="() => loginModel.Password" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <button type="submit" class="btn btn-uta-primary w-100 py-3 fw-bold rounded-3 shadow-sm" disabled="@(isLoading || (loginContext != null && !loginContext.Validate()))">


                        @if (isLoading)


                        {


                            <span class="spinner-border spinner-border-sm me-2"></span>


                            <span>Validando credenciales...</span>


                        }


                        else


                        {


                            <i class="bi bi-box-arrow-in-right me-2 fs-6"></i>


                            <span>Ingresar al Panel</span>


                        }


                    </button>


                </EditForm>


            }


            else


            {


                <EditForm EditContext="registerContext" OnValidSubmit="HandleRegister">


                    <DataAnnotationsValidator />





                    <div class="mb-3">


                        <label class="form-label fw-bold small text-dark">Nombre del local</label>


                        <InputText class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="registerModel.NombreCompleto" @bind-Value:after="RevalidarRegistro" placeholder="Ej: Comedor Doña María / Juan Pérez" />


                        <ValidationMessage For="() => registerModel.NombreCompleto" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <div class="mb-3">


                        <label class="form-label fw-bold small text-dark">Correo Electrónico</label>


                        <InputText class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="registerModel.Email" @bind-Value:after="RevalidarRegistro" placeholder="usuario@uta.edu.ec" />


                        <ValidationMessage For="() => registerModel.Email" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <div class="mb-3">


                        <label class="form-label fw-bold small text-dark">Teléfono</label>


                        <InputText class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="registerModel.Telefono" @bind-Value:after="RevalidarRegistro" placeholder="0991234567" />


                        <ValidationMessage For="() => registerModel.Telefono" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <div class="mb-4">


                        <label class="form-label fw-bold small text-dark">Contraseña</label>


                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50"><i class="bi bi-lock-fill"></i></span>
                            <InputText type="@(showRegisterPassword ? "text" : "password")" class="form-control text-dark fw-medium border-secondary border-opacity-50" @bind-Value="registerModel.Password" @bind-Value:after="RevalidarRegistro" placeholder="********" />
                            <span class="input-group-text bg-light text-secondary border-secondary border-opacity-50" style="cursor: pointer" @onclick="() => showRegisterPassword = !showRegisterPassword">
                                <i class="bi @(showRegisterPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </span>
                        </div>


                        <ValidationMessage For="() => registerModel.Password" class="text-danger small mt-1 fw-semibold" />


                    </div>





                    <button type="submit" class="btn btn-uta-primary w-100 py-3 fw-bold rounded-3 shadow-sm" disabled="@(isLoading || (registerContext != null && !registerContext.Validate()))">


                        @if (isLoading)


                        {


                            <span class="spinner-border spinner-border-sm me-2"></span>


                            <span>Creando cuenta...</span>


                        }


                        else


                        {


                            <i class="bi bi-check-circle-fill me-2 fs-6"></i>


                            <span>Registrar Cuenta</span>


                        }


                    </button>


                </EditForm>


            }


        </div>


    </div>


</div>





<style>


    .text-uta-blue {


        color: #003865 !important;


    }


    .btn-uta-primary {


        background-color: #004b87 !important;


        border-color: #004b87 !important;


        color: #ffffff !important;


        transition: background-color 0.15s ease;


    }


    .btn-uta-primary, .btn-uta-primary * {


        color: #ffffff !important;


    }


    .btn-uta-primary:hover {


        background-color: #002847 !important;


        border-color: #002847 !important;


        color: #ffffff !important;


    }


    .btn-uta-primary:hover * {


        color: #ffffff !important;


    }


</style>





@code {
    private bool showPassword = false;
    private bool showRegisterPassword = false;


    private bool isLogin = true;


    private bool isLoading = false;


    private string? errorMessage;





    private LoginModel loginModel = new();


    private RegisterModel registerModel = new();


    private EditContext? loginContext;


    private EditContext? registerContext;





    protected override void OnInitialized()


    {


        loginContext = new EditContext(loginModel);


        loginContext.OnFieldChanged += (s, e) => StateHasChanged();





        registerContext = new EditContext(registerModel);


        registerContext.OnFieldChanged += (s, e) => StateHasChanged();


    }





    private void RevalidarLogin()


    {


        loginContext?.Validate();


    }





    private void RevalidarRegistro()


    {


        registerContext?.Validate();


    }





    private async Task HandleLogin()


    {


        if (loginContext == null || !loginContext.Validate()) return;





        isLoading = true;


        errorMessage = null;





        var (eéeééééxito, mensaje, _) = await AuthService.LoginAsync(loginModel);


        isLoading = false;





        if (eéeééééxito)


        {


            Navigation.NavigateTo("", forceLoad: true);


        }


        else


        {


            errorMessage = mensaje ?? "Error al iniciar sesión. Verifique sus credenciales.";


        }


    }





    private async Task HandleRegister()


    {


        if (registerContext == null || !registerContext.Validate()) return;





        isLoading = true;


        errorMessage = null;





        var (eéeééééxito, mensaje, _) = await AuthService.RegisterAsync(registerModel);


        isLoading = false;





        if (eéeééééxito)


        {


            Navigation.NavigateTo("", forceLoad: true);


        }


        else


        {


            errorMessage = mensaje ?? "Error al registrar la cuenta. Verifique que el correo no estéé registrado.";


        }


    }


}





