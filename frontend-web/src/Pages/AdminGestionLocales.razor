@page "/admin/gestion-locales"




















@attribute [Authorize(Roles = "Administrador")]




















@inject AdminService AdminService




















@inject LocalService LocalService




















@inject NavigationManager Navigation




















@inject IConfiguration Configuration




















@inject IJSRuntime JS









































<PageTitle>Gestión de Locales - Administración UTA</PageTitle>









































<!-- Encabezado de la Pgina -->




















<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">




















    <div>




















        <h2 class="fw-bold mb-1 text-dark">Directorio de Locales</h2>




















        <p class="text-muted small mb-0">




















            Supervisa los comedores universitarios, audita calificaciones y gestiona el estado operativo.




















        </p>




















    </div>




















    <div class="d-flex gap-2 mt-3 mt-md-0">




















        <button class="btn btn-light text-primary border fw-bold px-3 shadow-sm" @onclick="CargarLocales">




















            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar




















        </button>




















        <a href="admin/locales" class="btn btn-primary fw-bold px-4 shadow-sm">




















            <i class="bi bi-shield-check me-2"></i> Validar RUCs




















        </a>




















    </div>




















</div>





























































































































<!-- Tarjeta Principal Unificadía -->




















<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">




















    




















    <!-- Seccin de Filtros Integradía -->




















    <div class="card-header bg-light border-bottom p-4">




















        <div class="row g-3">




















            <!-- Buscador -->




















            <div class="col-md-4">




















                <label class="form-label small fw-bold text-dark">Buscar Local o Propietario</label>




















                <div class="input-group">




















                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>




















                    <input type="text" class="form-control border-start-0" placeholder="Nombre, email, dirección..." 




















                           @bind="busqueda" @bind:event="oninput" @onkeyup="Filtrar" />




















                </div>




















            </div>




















            <div class="col-md-3">




















                <label class="form-label small fw-bold text-dark">




















                    <i class="bi bi-sort-down text-primary me-1"></i> Ordenar por




















                </label>




















                <select class="form-select fw-semibold" @bind="ordenSeleccionado" @bind:after="CargarLocales">




















                    <option value="estrellas_asc">Baja Calificación</option>




















                    <option value="estrellas_desc">Mayor Calificación</option>




















                    <option value="nombre_asc">Nombre Alfabético (A - Z)</option>




















                    <option value="pendientes_primero">Solicitudes Pendientes Primero</option>




















                    <option value="fecha_desc">Fecha de Registro Reciente</option>




















                </select>




















            </div>









































            <!-- Filtro por Campus -->




















            <div class="col-md-3">




















                <label class="form-label small fw-bold text-dark">Campus UTA</label>




















                <select class="form-select" @bind="campusSeleccionado" @bind:after="CargarLocales">




















                    <option value="">Todos los Campus</option>




















                    <option value="@CampusUTAModel.Huachi">Campus Huachi</option>




















                    <option value="@CampusUTAModel.Ingahurco">Campus Ingahurco</option>




















                    <option value="@CampusUTAModel.Querochaca">Campus Querochaca</option>




















                </select>




















            </div>









































            <!-- Filtro por Estado Operativo -->




















            <div class="col-md-2">




















                <label class="form-label small fw-bold text-dark">Estado</label>




















                <select class="form-select" @bind="filtroOperativo" @bind:after="CargarLocales">




















                    <option value="todos">Todos</option>




















                    <option value="habilitados">Solo Habilitados</option>




















                    <option value="deshabilitados">Deshabilitados</option>




















                    <option value="en_riesgo">En Riesgo (&lt; 3 estrellas)</option>




















                </select>




















            </div>




















                </div>




















    </div>









































    <!-- Seccin de Contenido / Tabla -->




















    <div class="card-body p-0">




















        @if (cargando)




















        {




















            <div class="text-center py-5">




















                <div class="spinner-border text-primary" role="status"></div>




















                <p class="mt-2 text-muted fw-semibold">Consultando directorio...</p>




















            </div>




















        }




















        else if (locales.Count == 0)




















        {




















            <div class="text-center p-5">




















                <i class="bi bi-inbox text-muted fs-1 mb-2"></i>




















                <h5 class="fw-bold text-dark">No se encontraron locales</h5>




















                <p class="text-muted small mb-0">No hay establecimientos que coincidían con los filtros aplicados.</p>




















            </div>




















        }




















        else




















        {




















            <div class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">




















                <span class="text-muted small fw-semibold">




















                    Mostrando <strong>@locales.Count</strong> establecimiento(s) registrado(s)




















                </span>




















            </div>









































            <div class="table-responsive">




















    <table class="table table-hover align-middle mb-0">




















        <thead class="table-light text-muted small text-uppercase">




















            <tr>




















                <th class="fw-bold border-bottom-0 py-3 ps-4">Local Comercial</th>




















                <th class="fw-bold border-bottom-0 py-3">Propietario</th>




















                <th class="fw-bold border-bottom-0 py-3">Calificación</th>




















                <th class="fw-bold border-bottom-0 py-3">Estado</th>




















                <th class="fw-bold border-bottom-0 py-3 text-end pe-4">Acciones</th>




















            </tr>




















        </thead>




















        <tbody>




















            <Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize Items="@locales" Context="local" OverscanCount="4">




















                @{




















                    var enRiesgo = local.TotalResenas > 0 && local.CalificacionPromedio < 3.0;




















                    var rowClass = local.EstadoAprobacion == EstadoAprobacionLocalModel.Pendiente ? "row-status-amber" : "";




















                    rowClass = local.EstadoAprobacion == EstadoAprobacionLocalModel.Rechazado ? "row-status-rose" : rowClass;








                    rowClass = (local.EstadoAprobacion == EstadoAprobacionLocalModel.Aprobado && local.EstaAbierto) ? "row-status-emerald" : rowClass;




















                }




















                <tr class="@rowClass">




















                    <td class="ps-4 py-3">




















                        <div class="fw-bold text-dark mb-1">@local.Nombre</div>




















                        <div class="text-muted small">




















                            @local.Categoria &bull; @local.CampusCercano




















                        </div>




















                    </td>




















                    <td>




















                        <div class="fw-semibold text-dark small">@local.PropietarioNombre</div>




















                        <div class="text-muted" style="font-size: 0.75rem;">




















                            @(string.IsNullOrEmpty(local.PropietarioEmail) ? "Sin correo" : local.PropietarioEmail)




















                        </div>




















                    </td>




















                    <td>


    <div class="d-flex flex-column align-items-start gap-2">


        @if (local.TotalResenas > 0)


        {


            <span class="fw-bold @(enRiesgo ? "text-danger" : "text-dark")">


                <i class="bi bi-star-fill text-warning me-1"></i> @local.CalificacionPromedio.ToString("0.0") / 5


            </span>


        }


        else


        {


            <span class="text-muted small">Sin calificaciones</span>


        }


        <button class="btn btn-light btn-sm rounded-pill px-3 shadow-sm text-primary fw-bold border" @onclick="() => AbrirModalResenas(local)">


            <i class="bi bi-chat-left-text me-1"></i> Ver Reseñas


        </button>


    </div>


</td>




















                    <td>




















                        <div class="d-flex flex-column gap-1 align-items-start">




















                            @switch (local.EstadoAprobacion)




















                            {




















                                case EstadoAprobacionLocalModel.Pendiente:




















                                    <span class="badge badge-amber small fw-bold"><i class="bi bi-clock-history me-1"></i> En Revisión</span>




















                                    break;




















                                case EstadoAprobacionLocalModel.Aprobado:




















                                    <span class="badge badge-emerald small fw-bold"><i class="bi bi-check-circle me-1"></i> Aprobado</span>




















                                    break;




















                                case EstadoAprobacionLocalModel.Rechazado:




















                                    <span class="badge badge-rose small fw-bold"><i class="bi bi-x-circle me-1"></i> Rechazado</span>




















                                    break;




















                            }




















                            @if (local.EstadoAprobacion == EstadoAprobacionLocalModel.Aprobado)




















                            {




















                                <span class="badge @(local.EstaAbierto ? "badge-slate" : "bg-light text-muted border") small fw-semibold">




















                                    @(local.EstaAbierto ? "Visible al Público" : "Oculto (Suspendido)")




















                                </span>




















                            }




















                        </div>




















                    </td>




















                    <td class="text-end pe-4">




















                        <div class="d-flex gap-2 justify-content-end">




















                            @if (!string.IsNullOrEmpty(local.CertificadoRucUrl))




















                            {




















                                <a href="@ObtenerUrlArchivo(local.CertificadoRucUrl)" target="_blank" class="btn btn-light btn-sm rounded-pill px-3 border shadow-sm fw-bold text-dark d-flex align-items-center gap-1 hover-elevate" title="Ver Documento RUC">











                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-6"></i> RUC











                                </a>




















                            }




















                            @if (local.EstaAbierto)




















                            {




















                                <button class="btn btn-rose btn-sm rounded-pill px-3 shadow-sm fw-bold d-flex align-items-center gap-1 hover-elevate" @onclick="() => AbrirModalDeshabilitar(local)" title="Suspender operaciones del local">











                                    <i class="bi bi-pause-circle-fill"></i> Suspender











                                </button>




















                            }




















                            else if (local.EstadoAprobacion == EstadoAprobacionLocalModel.Aprobado)




















                            {




















                                <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-bold d-flex align-items-center gap-1 hover-elevate" @onclick="() => ConfirmarHabilitar(local)" title="Reactivar operaciones del local">














                                    <i class="bi bi-play-circle-fill"></i> Activar














                                </button>




















                            }




















                        </div>




















                    </td>




















                </tr>




















            </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>




















        </tbody>




















    </table>




















        </div>




















    }




















    </div>




















</div>









































<!-- Modal: Deshabilitar / Suspender Local -->




















@if (mostrarModalDeshabilitar && localSeleccionado != null)




















{




















    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">




















        <div class="modal-dialog modal-dialog-centered">




















            <div class="modal-content rounded-4 border-0 shadow">




















                <div class="modal-header bg-primary text-white border-bottom-0 rounded-top-4">




















                    <h5 class="modal-title fw-bold text-white">Deshabilitar Local</h5>




















                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDeshabilitar"></button>




















                </div>




















                <div class="modal-body p-4">




















                    <p class="text-dark mb-2">




















                        Estás a punto de deshabilitar la disponibilidíad del local <strong>@localSeleccionado.Nombre</strong>.




















                    </p>




















                    <p class="text-muted small mb-3">




















                        El local dejará de aparecer visible para los estudiantes en la aplicación y se enviará una notificación por correo al propietario con el motivo especificado.




















                    </p>









































                    <div class="mb-3">




















                        <label class="form-label fw-bold text-dark small">Motivo de Deshabilitación / Suspensión *</label>




















                        <textarea class="form-control" rows="3" @bind="motivoDeshabilitacion" 




















                                  placeholder="Ej: Calificación promedio menúor a 2.5 estrellas y quejas recurrentes sobre higiene..."></textarea>




















                    </div>




















                </div>




















                <div class="modal-footer border-top-0 pt-0">




















                    <button type="button" class="btn btn-light" @onclick="CerrarModalDeshabilitar">Cancelar</button>




















                    <button type="button" class="btn btn-primary fw-bold px-4" 




















                            @onclick="ConfirmarDeshabilitar" 




















                            disabled="@(string.IsNullOrWhiteSpace(motivoDeshabilitacion) || procesando)">




















                        @if (procesando)




















                        {




















                            <span class="spinner-border spinner-border-sm me-1"></span>




















                        }




















                        Deshabilitar y Notificar




















                    </button>




















                </div>




















            </div>




















        </div>




















    </div>




















}









































<!-- Modal: Reseñas y Comentarios de Estudiantes -->




















@if (mostrarModalResenas && localSeleccionado != null)




















{




















    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">




















        <div class="modal-dialog modal-dialog-centered modal-lg">




















            <div class="modal-content rounded-4 border-0 shadow">




















                <div class="modal-header bg-white border-bottom rounded-top-4">




















                    <h5 class="modal-title fw-bold text-dark">




















                        <i class="bi bi-chat-heart-fill text-primary me-2"></i>Reseñas de Estudiantes - @localSeleccionado.Nombre




















                    </h5>




















                    <button type="button" class="btn-close" @onclick="CerrarModalResenas"></button>




















                </div>




















                <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">




















                    @if (cargandoResenas)




















                    {




















                        <div class="text-center py-4">




















                            <div class="spinner-border text-primary" role="status"></div>




















                            <p class="mt-2 text-muted small">Cargando comenútarios...</p>




















                        </div>




















                    }




















                    else if (resenasLocal.Count == 0)




















                    {




















                        <div class="text-center py-4 text-muted">




















                            <i class="bi bi-chat-square-dots fs-1 d-block mb-2"></i>




















                            Este local aún no ha recibido reseñas de los estudiantes.




















                        </div>




















                    }




















                    else




















                    {




















                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">




















                            <div>




















                                <span class="fs-4 fw-bold text-dark"><i class='bi bi-star-fill text-warning me-1'></i> @localSeleccionado.CalificacionPromedio.ToString("0.0")</span>




















                                <span class="text-muted small más-2">(@resenasLocal.Count calificaciones recibidías)</span>




















                            </div>




















                        </div>









































                        <div class="d-flex flex-column gap-3">




















                            @foreach (var r in resenasLocal)




















                            {




















                                <div class="p-3 rounded-3 border bg-light">




















                                    <div class="d-flex justify-content-between align-items-center mb-1">




















                                        <div>




















                                            <strong class="text-dark small">@r.EstudianteNombre</strong>




















                                            @if (!string.IsNullOrEmpty(r.EstudianteEmail))




















                                            {




















                                                <span class="text-muted small">(@r.EstudianteEmail)</span>




















                                            }




















                                        </div>




















                                        <div class="text-warning small fw-bold">




















                                            @for (int i = 1; i <= 5; i++)




















                                            {




















                                                if (i <= r.Calificacion)




















                                                {




















                                                    <i class="bi bi-star-fill text-warning"></i>




















                                                }




















                                                else




















                                                {




















                                                    <i class="bi bi-star text-muted"></i>




















                                                }




















                                            }




















                                            <span class="más-1 text-dark">(@r.Calificacion/5)</span>




















                                        </div>




















                                    </div>




















                                    <p class="text-dark mb-1 small">




















                                        @(string.IsNullOrWhiteSpace(r.Comentario) ? "Sin comenútario escrito." : $"\"{r.Comentario}\"")




















                                    </p>




















                                    <div class="text-muted" style="font-size: 0.7rem;">




















                                        <i class="bi bi-clock me-1"></i> @r.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")




















                                    </div>




















                                </div>




















                            }




















                        </div>




















                    }




















                </div>




















                <div class="modal-footer border-top-0 bg-light rounded-bottom-4 justify-content-between">








                    <div>








                        @if (localSeleccionado.EstaAbierto)








                        {








                            <button type="button" class="btn btn-rose px-4 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-1" @onclick="() => { CerrarModalResenas(); AbrirModalDeshabilitar(localSeleccionado); }">








                                <i class="bi bi-pause-circle-fill"></i> Suspender Local








                            </button>








                        }








                    </div>








                    <button type="button" class="btn btn-secondary px-4 rounded-pill fw-bold" @onclick="CerrarModalResenas">Cerrar</button>








                </div>




















            </div>




















        </div>




















    </div>




















}









































@code {




















    private bool cargando = true;




















    private bool procesando = false;




















    private string? mensajeExito;




















    private string? mensajeError;









































    private List<LocalAdminModel> locales = new();




















    private string busqueda = string.Empty;




















    private string ordenSeleccionado = "estrellas_asc"; // Menos estrellas primero por defecto




















    private CampusUTAModel? campusSeleccionado;




















    private string filtroOperativo = "todos";









































    // Modales




















    private bool mostrarModalDeshabilitar = false;




















    private string motivoDeshabilitacion = string.Empty;




















    private LocalAdminModel? localSeleccionado;









































    private bool mostrarModalResenas = false;




















    private bool cargandoResenas = false;




















    private List<ResenaDetalleModel> resenasLocal = new();









































    protected override async Task OnInitializedAsync()




















    {




















        await CargarLocales();




















    }









































    private async Task CargarLocales()




















    {




















        cargando = true;




















        









































        bool? soloBajaCalificacion = filtroOperativo == "en_riesgo" ? true : null;




















        bool? soloDeshabilitados = filtroOperativo == "deshabilitados" ? true : (filtroOperativo == "habilitados" ? false : null);









































        locales = await AdminService.GetLocalesAsync(




















            campus: campusSeleccionado,




















            soloBajaCalificacion: soloBajaCalificacion,




















            soloDeshabilitados: soloDeshabilitados,




















            search: string.IsNullOrWhiteSpace(busqueda) ? null : busqueda,




















            orderBy: ordenSeleccionado




















        );









































        cargando = false;




















    }









































    private void Filtrar()




















    {




















        _ = CargarLocales();




















    }









































    private string ObtenerUrlArchivo(string rutaRelativa)




















    {




















        if (string.IsNullOrWhiteSpace(rutaRelativa)) return "#";




















        if (rutaRelativa.StartsWith("http://") || rutaRelativa.StartsWith("https://")) return rutaRelativa;




















        var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5050/";




















        return $"{baseUrl.TrimEnd('/')}/{rutaRelativa.TrimStart('/')}";




















    }









































    private void AbrirModalDeshabilitar(LocalAdminModel local)




















    {




















        localSeleccionado = local;




















        motivoDeshabilitacion = string.Empty;




















        mostrarModalDeshabilitar = true;




















    }









































    private void CerrarModalDeshabilitar()




















    {




















        mostrarModalDeshabilitar = false;




















        localSeleccionado = null;




















        motivoDeshabilitacion = string.Empty;




















    }









































    private async Task ConfirmarDeshabilitar()




















    {




















        if (localSeleccionado == null || string.IsNullOrWhiteSpace(motivoDeshabilitacion)) return;









































        bool confirmed = await JS.InvokeAsync<bool>("confirmarAccion", $"Estás completamenúte seguro de suspender el local '{localSeleccionado.Nombre}'?");




















        if (!confirmed) return;









































        procesando = true;




















        




















        









































        var (eéeééééxito, localActualizado, err) = await AdminService.ToggleOperativoAsync(




















            localSeleccionado.Id,




















            habilitar: false,




















            motivo: motivoDeshabilitacion




















        );









































        if (eéeééééxito && localActualizado != null)




















        {




















            localSeleccionado.EstaAbierto = false;




















            localSeleccionado.MotivoRechazo = motivoDeshabilitacion;




















            await JS.InvokeVoidAsync("mostrarMensajeExito", $"El local '{localSeleccionado.Nombre}' fue deshabilitado y se notificó al propietario por correo.");




















            CerrarModalDeshabilitar();




















        }




















        else




















        {




















            await JS.InvokeVoidAsync("mostrarMensajeError", err ?? "Error al deshabilitar el local.");




















        }









































        procesando = false;




















    }









































    private async Task ConfirmarHabilitar(LocalAdminModel local)




















    {




















        bool confirmed = await JS.InvokeAsync<bool>("confirmarAccion", $"Estás seguro de volver a habilitar el local '{local.Nombre}' en el sistema?");




















        if (!confirmed) return;




















        




















        procesando = true;




















        




















        









































        var (eéeééééxito, localActualizado, err) = await AdminService.ToggleOperativoAsync(




















            local.Id,




















            habilitar: true




















        );









































        if (eéeééééxito && localActualizado != null)




















        {




















            local.EstaAbierto = true;




















            local.MotivoRechazo = null;




















            await JS.InvokeVoidAsync("mostrarMensajeExito", $"Â¡El local '{local.Nombre}' ha sido habilitado nuevamenúte!");




















        }




















        else




















        {




















            await JS.InvokeVoidAsync("mostrarMensajeError", err ?? "Error al habilitar el local.");




















        }









































        procesando = false;




















    }









































    private async Task AbrirModalResenas(LocalAdminModel local)




















    {




















        localSeleccionado = local;




















        mostrarModalResenas = true;




















        cargandoResenas = true;




















        resenasLocal = await AdminService.GetResenasAsync(local.Id);




















        cargandoResenas = false;




















    }









































    private void CerrarModalResenas()




















    {




















        mostrarModalResenas = false;




















        localSeleccionado = null;




















        resenasLocal.Clear();




















    }




















}























































































































