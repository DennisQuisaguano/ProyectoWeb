@page "/admin/claves"
@using src.Models
@using src.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject AdminService AdminService

<PageTitle>Solicitudes de Restablecimiento de Contraseña - Panel Admin</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-dark fw-bold">Solicitudes de Restablecimiento de Contraseña</h3>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando solicitudes...</p>
        </div>
    }
    else if (!solicitudes.Any())
    {
        <div class="alert alert-info">
            No hay solicitudes de restablecimiento de contraseña pendientes.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Teléfono Confirmado</th>
                            <th>Fecha Solicitud</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in solicitudes)
                        {
                            <tr>
                                <td><span class="fw-medium">@solicitud.NombreCompleto</span></td>
                                <td>@solicitud.Email</td>
                                <td>@solicitud.Telefono</td>
                                <td>@(solicitud.RequestedAt?.ToString("g") ?? "N/A")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success me-2" @onclick="() => Aprobar(solicitud.Id)">
                                        <i class="bi bi-check-circle"></i> Aprobar
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Rechazar(solicitud.Id)">
                                        <i class="bi bi-x-circle"></i> Rechazar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<PendingPasswordResetModel> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        isLoading = true;
        solicitudes = await AdminService.GetPendingPasswordResetsAsync();
        isLoading = false;
    }

    private async Task Aprobar(Guid id)
    {
        var exito = await AdminService.ApprovePasswordResetAsync(id);
        if (exito)
        {
            await CargarSolicitudes();
        }
    }

    private async Task Rechazar(Guid id)
    {
        var exito = await AdminService.RejectPasswordResetAsync(id);
        if (exito)
        {
            await CargarSolicitudes();
        }
    }
}
