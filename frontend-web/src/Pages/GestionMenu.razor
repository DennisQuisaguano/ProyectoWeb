    private async Task GuardarPlato()

    {

        bool confirmed = await JS.InvokeAsync<bool>("confirmarAccion", "¿Estás seguro de que deseas guardar los cambios en el menú?");

        if (!confirmed) return;



        guardandoPlato = true;



        if (esEdicion)



        {



            var (exito, actualizado, msg) = await MenuService.UpdateAsync(modeloFormulario);



            if (exito && actualizado != null)



            {



                var index = platos.FindIndex(p => p.Id == actualizado.Id);



                if (index >= 0)



                {



                    platos[index] = actualizado;



                }



                NotificationService.ShowSuccess($"El producto '{actualizado.Nombre}' se ha modificado correctamenúúte.");



                mostrarModal = false;



            }



            else



            {



                NotificationService.ShowError(msg ?? "Error al actualizar el producto.");



            }



        }



        else



        {



            var (exito, creado, msg) = await MenuService.CreateAsync(modeloFormulario);



            if (exito && creado != null)



            {



                platos.Insert(0, creado);



                NotificationService.ShowSuccess($"Producto '{creado.Nombre}' creado exitosamenúúte en el menúúú.");



                mostrarModal = false;



            }



            else



            {



                NotificationService.ShowError(msg ?? "Error al crear el producto.");



            }



        }







        guardandoPlato = false;



    }







    private async Task EliminarPlato(PlatoModel plato)

    {

        bool confirmed = await JS.InvokeAsync<bool>("confirmarAccion", $"¿Estás seguro de que deseas eliminar '{plato.Nombre}'?");

        if (!confirmed) return;



        var exito = await MenuService.DeleteAsync(plato.Id);



        if (exito)



        {



            platos.Remove(plato);



            NotificationService.ShowSuccess($"El producto '{plato.Nombre}' ha sido eliminado.");



        }



        else



        {



            NotificationService.ShowError("Error al eliminar el producto.");



        }



    }



