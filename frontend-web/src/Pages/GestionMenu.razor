    private string ObtenerUrlImagen(string? url)



    {



        if (string.IsNullOrWhiteSpace(url)) return "https://placehold.co/150x150/003865/ffffff?text=Plato";



        if (url.StartsWith("http")) return url;



        var baseUrl = "http://localhost:5050/"; // Se puede mover a config



        return $"{baseUrl.TrimEnd('/')}/{url.TrimStart('/')}";



    }







    private async Task SubirImagen(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)



    {



        var archivo = e.File;



        if (archivo == null) return;







        if (archivo.Size > 5 * 1024 * 1024)



        {



            NotificationService.ShowError("La imagen no debe exceder los 5 MB.");



            return;



        }







        subiendoImagen = true;



        try



        {



            using var stream = archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);



            var (exito, url, msg) = await LocalService.SubirImagenAsync(stream, archivo.Name);



            



            if (exito && !string.IsNullOrEmpty(url))



            {



                modeloFormulario.ImagenUrl = url;



                NotificationService.ShowSuccess("Imagen subidía correctamenúúte.");



            }



            else



            {



                NotificationService.ShowError(msg ?? "Error al subir la imagen.");



            }



        }



        catch (Exception ex)



        {



            NotificationService.ShowError($"Error al subir imagen: {ex.Message}");



        }



        finally



        {



            subiendoImagen = false;



        }



    }







