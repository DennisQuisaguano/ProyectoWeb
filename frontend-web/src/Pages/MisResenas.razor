@page "/resenas"
@attribute [Authorize]
@inject LocalService LocalService

<PageTitle>Opiniones y Reseñas - Sistema Gastronómico UTA</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Opiniones y Reseñas</h2>
        <p class="text-muted small mb-0">Descubre las opiniones que los estudiantes dejan sobre tus locales</p>
    </div>
    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="CargarResenasAsync">
        <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
    </button>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Cargando opiniones de los estudiantes...</p>
    </div>
}
else if (!resenas.Any())
{
    <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center">
        <div class="mb-3 text-muted display-4">
            <i class="bi bi-chat-square-heart"></i>
        </div>
        <h4 class="fw-bold text-dark">Aún no hay reseñas registradas</h4>
        <p class="text-muted small">Cuando los estudiantes califiquen tus locales desde la aplicación móvil Flutter, aparecerán aquí en tiempo real.</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <!-- Tarjeta de Calificación Global -->
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-4 text-center">
                <h5 class="fw-bold text-muted small text-uppercase mb-3">Calificación Global</h5>
                <h1 class="display-1 fw-bold text-dark mb-0">@calificacionPromedio.ToString("0.0")</h1>
                <div class="text-warning fs-4 mb-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Floor(calificacionPromedio))
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else if (i - 0.5 <= calificacionPromedio)
                        {
                            <i class="bi bi-star-half"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }
                </div>
                <p class="text-muted small fw-semibold mb-0">Basado en @resenas.Count @(resenas.Count == 1 ? "opinión" : "opiniones")</p>
            </div>
        </div>
        
        <div class="col-12 col-md-8">
            <!-- Resumen de progreso -->
            <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-muted small text-uppercase mb-3">Distribución de opiniones</h5>
                
                @for (int estrellas = 5; estrellas >= 1; estrellas--)
                {
                    var count = conteoEstrellas.GetValueOrDefault(estrellas, 0);
                    var porcentaje = resenas.Count > 0 ? (count * 100) / resenas.Count : 0;
                    var colorBarra = estrellas switch {
                        5 => "bg-success",
                        4 => "bg-primary",
                        3 => "bg-info",
                        2 => "bg-warning",
                        _ => "bg-danger"
                    };

                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="text-dark small fw-bold" style="width: 25px;">@estrellas <i class="bi bi-star-fill text-warning"></i></span>
                        <div class="progress flex-grow-1" style="height: 10px;">
                            <div class="progress-bar @colorBarra rounded-pill" style="width: @(porcentaje)%"></div>
                        </div>
                        <span class="text-muted small" style="width: 30px;">@count</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Lista de Reseñas Reales -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="list-group list-group-flush">
            @foreach (var resena in resenas)
            {
                <div class="list-group-item p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                @ObtenerIniciales(resena.EstudianteNombre)
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@resena.EstudianteNombre</h6>
                                <span class="text-muted small">@resena.Fecha.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                        </div>
                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= resena.Calificacion)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>
                    </div>
                    <div class="mt-2 mb-2">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-shop me-1 text-primary"></i> @resena.LocalNombre
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(resena.Comentario))
                    {
                        <p class="text-muted small mb-0">
                            @resena.Comentario
                        </p>
                    }
                    else
                    {
                        <p class="text-muted small fst-italic mb-0">
                            (Sin comentario escrito)
                        </p>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .filter-tab-pill {
        border-radius: 50rem;
        padding: 0.5rem 1.2rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s ease-in-out;
    }
    .active-primary {
        background-color: #e6f0ff;
        color: #0d6efd;
    }
</style>

@code {
    private List<ResenaDetalleModel> resenas = new();
    private bool cargando = true;
    private double calificacionPromedio = 0.0;
    private Dictionary<int, int> conteoEstrellas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarResenasAsync();
    }

    private async Task CargarResenasAsync()
    {
        cargando = true;
        try
        {
            resenas = await LocalService.GetMisResenasAsync();
            if (resenas.Any())
            {
                calificacionPromedio = Math.Round(resenas.Average(r => r.Calificacion), 1);
                conteoEstrellas = resenas
                    .GroupBy(r => r.Calificacion)
                    .ToDictionary(g => g.Key, g => g.Count());
            }
            else
            {
                calificacionPromedio = 0.0;
                conteoEstrellas.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reseñas: {ex.Message}");
            resenas = new();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "ES";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpper();
        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }
}
