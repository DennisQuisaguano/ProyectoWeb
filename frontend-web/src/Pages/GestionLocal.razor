<!-- Modal de Mapa -->
@if (mostrarModalMapa)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-map-fill text-white me-2"></i>Selecciona la Ubicación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalMapa"></button>
                </div>
                <div class="modal-body p-0" style="height: 400px; position: relative;">
                    <div id="map" style="width: 100%; height: 100%;"></div>
                    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3" style="z-index: 1000;">
                        <div class="bg-white px-3 py-2 rounded-pill shadow-sm fw-bold small border text-dark">
                            <i class="bi bi-arrows-move me-1 text-primary"></i> Arrastra el marcador azul hasta tu local
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4 fw-bold" @onclick="CerrarModalMapa">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="ConfirmarUbicacion">
                        Confirmar Ubicación
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool cargandoGps = false;
    private bool mostrarModalMapa = false;
    private DotNetObjectReference<GestionLocal>? objRef;
    private double tempLat = 0;
    private double tempLng = 0;
    private string tempAddress = "";

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private async Task AbrirModalMapa()
    {
        cargandoGps = true;
        StateHasChanged();
        
        double lat = modelo.Latitud != 0 ? modelo.Latitud : -1.2491; // Default to Ambato approx
        double lng = modelo.Longitud != 0 ? modelo.Longitud : -78.6253;

        try
        {
            if (modelo.Latitud == 0 && modelo.Longitud == 0)
            {
                var coords = await JS.InvokeAsync<Coordinates>("getGeolocation");
                lat = coords.Latitud;
                lng = coords.Longitud;
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("No se pudo obtener tu ubicación automática. Arrastra el pin en el mapa.");
        }

        cargandoGps = false;
        tempLat = lat;
        tempLng = lng;
        tempAddress = modelo.Direccion ?? "";
        mostrarModalMapa = true;
        StateHasChanged();

        await Task.Delay(100);
        await JS.InvokeVoidAsync("initializeMap", lat, lng, objRef);
    }

    private void CerrarModalMapa()
    {
        mostrarModalMapa = false;
    }

    [JSInvokable]
    public void UpdateLocationFromMap(double lat, double lng, string address)
    {
        tempLat = lat;
        tempLng = lng;
        if (!string.IsNullOrWhiteSpace(address))
        {
            tempAddress = address;
        }
        StateHasChanged();
    }

    private void ConfirmarUbicacion()
    {
        modelo.Latitud = tempLat;
        modelo.Longitud = tempLng;
        
        if (!string.IsNullOrWhiteSpace(tempAddress))
        {
            modelo.Direccion = tempAddress;
        }

        var huachi = (-1.2683, -78.6253);
        var ingahurco = (-1.2491, -78.6225);
        var querochaca = (-1.3323, -78.6189);

        var distHuachi = Math.Pow(tempLat - huachi.Item1, 2) + Math.Pow(tempLng - huachi.Item2, 2);
        var distIngahurco = Math.Pow(tempLat - ingahurco.Item1, 2) + Math.Pow(tempLng - ingahurco.Item2, 2);
        var distQuerochaca = Math.Pow(tempLat - querochaca.Item1, 2) + Math.Pow(tempLng - querochaca.Item2, 2);

        if (distHuachi <= distIngahurco && distHuachi <= distQuerochaca)
            modelo.CampusCercano = CampusUTAModel.Huachi;
        else if (distIngahurco <= distHuachi && distIngahurco <= distQuerochaca)
            modelo.CampusCercano = CampusUTAModel.Ingahurco;
        else
            modelo.CampusCercano = CampusUTAModel.Querochaca;

        mostrarModalMapa = false;
        Revalidar();
    }

    private TimeOnly horaInicio = new TimeOnly(7, 30);
    private TimeOnly horaFin = new TimeOnly(18, 0);

    private void ActualizarHorario()
    {
        if (horaInicio >= horaFin)
        {
            horaFin = horaInicio.AddHours(1);
        }
        modelo.HorarioApertura = $"{horaInicio:HH\\:mm} - {horaFin:HH\\:mm}";
        Revalidar();
    }

    private bool cargando = true;
    private bool guardando = false;
    private bool subiendoPdf = false;
    private bool subiendoPortada = false;

    private CreateOrUpdateLocalModel modelo = new();
    private bool esEdicion = false;
    private EditContext? editContext;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        var locales = await LocalService.GetMisLocalesAsync();
        var local = locales.FirstOrDefault();

        if (local != null)
        {
            esEdicion = true;
            modelo = new CreateOrUpdateLocalModel
            {
                Id = local.Id,
                Nombre = local.Nombre,
                Descripcion = local.Descripcion,
                Direccion = local.Direccion,
                Referencia = local.Referencia,
                CampusCercano = local.CampusCercano,
                Categoria = local.Categoria,
                Latitud = local.Latitud,
                Longitud = local.Longitud,
                TelefonoContacto = local.TelefonoContacto,
                WhatsApp = local.WhatsApp,
                HorarioApertura = local.HorarioApertura,
                LogoUrl = local.LogoUrl,
                PortadaUrl = local.PortadaUrl,
                EstaAbierto = local.EstaAbierto,
                PropietarioId = local.PropietarioId,
                CertificadoRucUrl = local.CertificadoRucUrl,
                EstadoAprobacion = local.EstadoAprobacion,
                MotivoRechazo = local.MotivoRechazo
            };
        }
        else
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null && Guid.TryParse(user.Id, out var uid))
            {
                modelo.PropietarioId = uid;
            }
        }

        if (!string.IsNullOrEmpty(local.HorarioApertura))
        {
            var parts = local.HorarioApertura.Split(new[] { " - ", " a ", "a" }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (TimeOnly.TryParse(parts[0].Trim(), out var parsedInicio)) horaInicio = parsedInicio;
                if (TimeOnly.TryParse(parts[1].Trim(), out var parsedFin)) horaFin = parsedFin;
            }
        }
        ActualizarHorario();

        if (!string.IsNullOrEmpty(local.HorarioApertura))
        {
            var parts = local.HorarioApertura.Split(new[] { " - ", " a ", "a" }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (TimeOnly.TryParse(parts[0].Trim(), out var parsedInicio)) horaInicio = parsedInicio;
                if (TimeOnly.TryParse(parts[1].Trim(), out var parsedFin)) horaFin = parsedFin;
            }
        }
        ActualizarHorario();

        editContext = new EditContext(modelo);
        editContext.OnFieldChanged += (s, e) => StateHasChanged();

        cargando = false;
    }

    private void Revalidar()
    {
        if (editContext != null)
        {
            editContext.Validate();
        }
    }

    private string ObtenerUrlArchivo(string rutaRelativa)
    {
        if (string.IsNullOrWhiteSpace(rutaRelativa)) return "#";
        if (rutaRelativa.StartsWith("http://") || rutaRelativa.StartsWith("https://")) return rutaRelativa;
        var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5050/";
        return $"{baseUrl.TrimEnd('/')}/{rutaRelativa.TrimStart('/')}";
    }

        private async Task SubirFotoPortada(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;

        if (archivo.Size > 5 * 1024 * 1024)
        {
            NotificationService.ShowError("La imagen no debe exceder los 5 MB.");
            return;
        }

        subiendoPortada = true;
        StateHasChanged();

        try
        {
            using var stream = archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var (exito, url, msg) = await LocalService.SubirImagenAsync(stream, archivo.Name);

            if (exito && !string.IsNullOrEmpty(url))
            {
                modelo.PortadaUrl = url;
                Revalidar();
                NotificationService.ShowSuccess("Foto subida correctamente.");
            }
            else
            {
                NotificationService.ShowError(msg ?? "Ocurrió un error al subir la foto.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Error al subir la foto: " + ex.Message);
        }
        finally
        {
            subiendoPortada = false;
            StateHasChanged();
        }
    }

private async Task SubirCertificadoRuc(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;

        if (!archivo.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            NotificationService.ShowError("Por favor, sube únicamente archivos en formato PDF.");
            return;
        }

        if (archivo.Size > 5 * 1024 * 1024)
        {
            NotificationService.ShowError("El archivo PDF no debe exceder los 5 MB.");
            return;
        }

        subiendoPdf = true;

        try
        {
            using var stream = archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var (exito, url, msg) = await LocalService.SubirRucAsync(stream, archivo.Name);

            if (exito && !string.IsNullOrEmpty(url))
            {
                modelo.CertificadoRucUrl = url;
                Revalidar();
                NotificationService.ShowSuccess("Certificado RUC subido exitosamente. Guarda los cambios para enviar tu solicitud.");
            }
            else
            {
                NotificationService.ShowError(msg ?? "Error al subir el certificado PDF.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error al procesar el archivo: {ex.Message}");
        }
        finally
        {
            subiendoPdf = false;
        }
    }

    private async Task CapturarCoordenadasGps()
    {
        try
        {
            var coords = await JSRuntime.InvokeAsync<Coordinates>("getGeolocation");
            modelo.Latitud = coords.Latitud;
            modelo.Longitud = coords.Longitud;

            var huachi = (-1.2694, -78.6255);
            var ingahurco = (-1.2461, -78.6277);
            var querochaca = (-1.3533, -78.6186);

            var distHuachi = Math.Pow(coords.Latitud - huachi.Item1, 2) + Math.Pow(coords.Longitud - huachi.Item2, 2);
            var distIngahurco = Math.Pow(coords.Latitud - ingahurco.Item1, 2) + Math.Pow(coords.Longitud - ingahurco.Item2, 2);
            var distQuerochaca = Math.Pow(coords.Latitud - querochaca.Item1, 2) + Math.Pow(coords.Longitud - querochaca.Item2, 2);

            if (distHuachi <= distIngahurco && distHuachi <= distQuerochaca)
                modelo.CampusCercano = CampusUTAModel.Huachi;
            else if (distIngahurco <= distHuachi && distIngahurco <= distQuerochaca)
                modelo.CampusCercano = CampusUTAModel.Ingahurco;
            else
                modelo.CampusCercano = CampusUTAModel.Querochaca;

            NotificationService.ShowSuccess("Ubicación GPS capturada correctamente.");
            Revalidar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"No se pudo obtener la ubicación: {ex.Message}");
            NotificationService.ShowError("No pudimos acceder a tu GPS. Asegúrate de darle permisos al navegador.");
        }
    }

    private async Task GuardarLocal()
    {
        if (editContext == null || !editContext.Validate())
        {
            NotificationService.ShowError("Revisa los errores en el formulario antes de guardar.");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirmarAccion", "¿Estás seguro de que deseas guardar los cambios en tu local?");
        if (!confirmed) return;

        guardando = true;

        if (esEdicion)
        {
            var (exito, _, msg) = await LocalService.UpdateAsync(modelo);
            if (exito)
            {
                NotificationService.ShowSuccess("Los datos de tu local se actualizaron con éxito.");
            }
            else
            {
                NotificationService.ShowError(msg ?? "Error al actualizar los datos.");
            }
        }
        else
        {
            var (exito, creado, msg) = await LocalService.CreateAsync(modelo);
            if (exito && creado != null)
            {
                esEdicion = true;
                modelo.Id = creado.Id;
                modelo.EstadoAprobacion = creado.EstadoAprobacion;
                NotificationService.ShowSuccess("¡¡Tu local ha sido registrado exitosamente! Está en revisión por un administrador.");
            }
            else
            {
                NotificationService.ShowError(msg ?? "Error al registrar el local.");
            }
        }

        guardando = false;
    }

