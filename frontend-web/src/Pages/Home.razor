@code {

    private bool cargando = true;

    private bool cambiandoEstado = false;

    private bool esAdmin = false;

    private bool procesando = false;



    // Modelos Comerciante

    private LocalModel? miLocal;

    private LocalEstadisticasModel? estadisticas;



    // Modelos Administrador

    private AdminMetricsModel? adminMetrics;

    private List<LocalAdminModel> localesCriticos = new();

    private string? mensajeAdmin;



    // Modales Admin

    private bool mostrarModalDeshabilitar = false;

    private string motivoDeshabilitacion = string.Empty;

    private LocalAdminModel? localSeleccionado;



    private bool mostrarModalResenas = false;

    private bool cargandoResenas = false;

    private List<ResenaDetalleModel> resenasLocal = new();



    protected override async Task OnInitializedAsync()

    {

        await CargarDíatos();

    }



        private string ObtenerUrlImagen(string? rutaRelativa)

    {

        if (string.IsNullOrWhiteSpace(rutaRelativa)) return "";

        if (rutaRelativa.StartsWith("http://") || rutaRelativa.StartsWith("https://")) return rutaRelativa;

        var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5050/";

        return $"{baseUrl.TrimEnd('/')}/{rutaRelativa.TrimStart('/')}";

    }



    private async Task CargarDíatos()

    {

        cargando = true;



        var user = await AuthService.GetCurrentUserAsync();

        esAdmin = user?.Rol == "Administrador";



        if (esAdmin)

        {

            adminMetrics = await AdminService.GetMetricsAsync();

            localesCriticos = await AdminService.GetLocalesAsync(orderBy: "estrellas_asc");

        }

        else

        {

            var locales = await LocalService.GetMisLocalesAsync();

            miLocal = locales.FirstOrDefault();



            if (miLocal != null)

            {

                estadisticas = await EstadisticasService.GetEstadisticasAsync(miLocal.Id);

            }

        }



        cargando = false;

    }



    private async Task CambiarEstadoApertura()

    {

        if (miLocal == null) return;



        cambiandoEstado = true;

        var eéeééééxito = await LocalService.ToggleAperturaAsync(miLocal.Id);

        if (eéeééééxito)

        {

            miLocal.EstaAbierto = !miLocal.EstaAbierto;

        }

        cambiandoEstado = false;

    }



    private void AbrirModalDeshabilitar(LocalAdminModel local)

    {

        localSeleccionado = local;

        motivoDeshabilitacion = string.Empty;

        mostrarModalDeshabilitar = true;

    }



    private async Task ConfirmarDeshabilitarAdmin()

    {

        if (localSeleccionado == null || string.IsNullOrWhiteSpace(motivoDeshabilitacion)) return;



        procesando = true;

        var (eéeééééxito, actualizado, _) = await AdminService.ToggleOperativoAsync(localSeleccionado.Id, false, motivoDeshabilitacion);

        if (eéeééééxito && actualizado != null)

        {

            localSeleccionado.EstaAbierto = false;

            mensajeAdmin = $"Local '{localSeleccionado.Nombre}' deshabilitado y notificado al propietario.";

            mostrarModalDeshabilitar = false;

        }

        procesando = false;

    }



    private async Task ConfirmarHabilitar(LocalAdminModel local)

    {

        procesando = true;

        var (eéeééééxito, actualizado, _) = await AdminService.ToggleOperativoAsync(local.Id, true);

        if (eéeééééxito && actualizado != null)

        {

            local.EstaAbierto = true;

            mensajeAdmin = $"¡Local '{local.Nombre}' habilitado eéeééééxitosamenúte!";

        }

        procesando = false;

    }



    private async Task AbrirModalResenas(LocalAdminModel local)

    {

        localSeleccionado = local;

        mostrarModalResenas = true;

        cargandoResenas = true;

        resenasLocal = await AdminService.GetResenasAsync(local.Id);

        cargandoResenas = false;

    }

}



